  "components": [
    {
      "name": "主要按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "正式保存与核对行动，最小高度48px。",
      "html": "<button class=\"ds-control ds-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg>保存支出</button>",
      "css": ".ds-primary{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:48px;padding:12px 17px;border:0;border-radius:10px;font-size:14px;font-weight:600;background:var(--primary,#235ee8);color:white}.ds-primary:hover{background:var(--primary-dark,#1745b5)}.ds-control{transition:background-color 160ms,color 160ms,transform 160ms cubic-bezier(.16,1,.3,1),box-shadow 160ms;cursor:pointer;touch-action:manipulation}.ds-control:active{transform:scale(.96)}.ds-control:disabled{opacity:.4;cursor:default;transform:none}.ds-control:focus-visible{outline:3px solid #719af2;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-control{transition-duration:1ms!important}}"
    },
    {
      "name": "次要按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "导出、编辑或取消等次行动。",
      "html": "<button class=\"ds-control ds-secondary\">导出备份</button>",
      "css": ".ds-secondary{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:48px;padding:12px 17px;border:0;border-radius:10px;font-size:14px;font-weight:600;background:var(--soft,#edf3ff);color:#2554b6}.ds-secondary:hover{background:#dce8ff}.ds-control{transition:background-color 160ms,color 160ms,transform 160ms cubic-bezier(.16,1,.3,1),box-shadow 160ms;cursor:pointer;touch-action:manipulation}.ds-control:active{transform:scale(.96)}.ds-control:disabled{opacity:.4;cursor:default;transform:none}.ds-control:focus-visible{outline:3px solid #719af2;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-control{transition-duration:1ms!important}}"
    },
    {
      "name": "普通输入",
      "kind": "input",
      "refersTo": "input",
      "description": "商户与备注输入，聚焦时蓝色边框和可见轮廓。",
      "html": "<label class=\"ds-field-label\" for=\"ds-note\">商户 / 备注</label><input class=\"ds-field\" id=\"ds-note\" placeholder=\"例如 午餐\" />",
      "css": ".ds-field-label{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;display:block;font-size:13px;color:#53647b;line-height:1.6}.ds-field{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;display:block;width:100%;min-width:0;min-height:48px;margin-top:6px;padding:11px 12px;border:1px solid #ccd4df;border-radius:10px;background:white;color:var(--ink,#17212f);transition:border-color 160ms,box-shadow 160ms}.ds-field::placeholder{color:#6b7789}.ds-field:hover,.ds-field:focus{border-color:var(--primary,#235ee8)}.ds-field:focus-visible{outline:3px solid #719af2;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-field{transition-duration:1ms}}"
    },
    {
      "name": "底部导航",
      "kind": "nav",
      "refersTo": "bottom-nav",
      "description": "三个固定入口，当前账单页的浅蓝指示块仅位于图标背后。",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><button class=\"ds-control\"><span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4\"/><path d=\"M2 6h4\"/><path d=\"M2 10h4\"/><path d=\"M2 14h4\"/><path d=\"M2 18h4\"/><path d=\"M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z\"/></svg></span>备忘录</button><button class=\"ds-control ds-nav-active\" aria-current=\"page\"><span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 2v4\"/><path d=\"M16 2v4\"/><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"/><path d=\"M3 10h18\"/><path d=\"M8 14h.01\"/><path d=\"M12 14h.01\"/><path d=\"M16 14h.01\"/><path d=\"M8 18h.01\"/><path d=\"M12 18h.01\"/><path d=\"M16 18h.01\"/></svg></span>账单花销</button><button class=\"ds-control\"><span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10 5H3\"/><path d=\"M12 19H3\"/><path d=\"M14 3v4\"/><path d=\"M16 17v4\"/><path d=\"M21 12h-9\"/><path d=\"M21 19h-5\"/><path d=\"M21 5h-7\"/><path d=\"M8 10v4\"/><path d=\"M8 12H3\"/></svg></span>设置</button></nav>",
      "css": ".ds-nav{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;position:relative;isolation:isolate;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:white;border-top:1px solid var(--line,#e7ebf1);padding:8px 14px 9px;box-shadow:0 -5px 17px #1c355006}.ds-nav:before{content:\"\";position:absolute;z-index:-1;top:8px;left:calc(50% - 24px);width:48px;height:29px;border-radius:12px;background:var(--soft,#edf3ff);transition:transform 280ms cubic-bezier(.16,1,.3,1)}.ds-nav button{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;border:0;background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;height:54px;padding:0;border-radius:10px;font-size:11px;color:var(--muted,#637084)}.ds-nav button>span{height:29px;width:48px;display:grid;place-items:center}.ds-nav .ds-nav-active{color:var(--primary,#235ee8);font-weight:600}.ds-nav button:hover{color:var(--primary,#235ee8)}.ds-control{transition:background-color 160ms,color 160ms,transform 160ms cubic-bezier(.16,1,.3,1),box-shadow 160ms;cursor:pointer;touch-action:manipulation}.ds-control:active{transform:scale(.96)}.ds-control:disabled{opacity:.4;cursor:default;transform:none}.ds-control:focus-visible{outline:3px solid #719af2;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-control{transition-duration:1ms!important}}"
    },
    {
      "name": "状态标签",
      "kind": "chip",
      "refersTo": "pill",
      "description": "状态展示，非交互控件。",
      "html": "<span class=\"ds-pill\">3 笔待核对</span>",
      "css": ".ds-pill{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;display:inline-block;padding:5px 8px;border-radius:6px;background:var(--soft,#edf3ff);color:#315bba;font-size:11px;white-space:nowrap}"
    },
    {
      "name": "白色功能卡片",
      "kind": "card",
      "refersTo": "card",
      "description": "功能模块的浅边、低阴影表面；示例是原卡片结构的静态样本。",
      "html": "<section class=\"ds-card\"><div class=\"ds-card-heading\"><h2>消费日历</h2><span>点日期看明细</span></div><p>金额单位 元 · 蓝色边框为今天</p></section>",
      "css": ".ds-card{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;background:white;color:var(--ink,#17212f);border:1px solid #e9edf4;border-radius:17px;padding:19px;box-shadow:0 3px 10px #1c345405}.ds-card-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:15px}.ds-card h2{margin:0;font-size:17px;font-weight:650}.ds-card-heading span,.ds-card p{margin:0;font-size:11px;color:var(--muted,#637084);line-height:1.7}@media(max-width:700px){.ds-card{padding:16px 14px}.ds-card h2{font-size:16px}}@media(max-width:360px){.ds-card{padding:14px 11px}}"
    },
    {
      "name": "蓝色月总额",
      "kind": "card",
      "refersTo": "summary-card",
      "description": "总额、日均和消费笔数；金额是组件展示样例。",
      "html": "<section class=\"ds-summary\"><span class=\"ds-summary-label\">10月总花销</span><div class=\"ds-summary-value\"><span>¥</span>1280.00</div><div class=\"ds-summary-meta\"><span>日均 ¥106.67</span><span>12笔消费 · 8天有支出</span></div></section>",
      "css": ".ds-summary{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;background:var(--primary,#235ee8);color:white;border-radius:18px;padding:20px;font-variant-numeric:tabular-nums}.ds-summary-label{display:block;font-size:13px;color:#e1eaff;margin-bottom:7px}.ds-summary-value{font-size:40px;font-weight:650;line-height:1.25;letter-spacing:-.025em;white-space:nowrap}.ds-summary-value>span{font-size:22px;font-weight:450;margin-right:5px}.ds-summary-meta{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:10px;font-size:11px;color:#e1eaff;line-height:1.6}@media(min-width:700px){.ds-summary{padding:25px}.ds-summary-value{font-size:44px}}@media(max-width:700px){.ds-summary{padding:18px}.ds-summary-value{font-size:38px}}@media(max-width:360px){.ds-summary{padding:16px}.ds-summary-value{font-size:35px}.ds-summary-meta{flex-wrap:wrap;font-size:10px}}"
    },
    {
      "name": "日期方块",
      "kind": "custom",
      "refersTo": "calendar-day",
      "description": "静态展示今日有支出状态，正方形尺寸由七列网格决定。",
      "html": "<div class=\"ds-calendar\"><button class=\"ds-control ds-day\" aria-label=\"10月12日 支出128元 查看明细\"><span class=\"ds-number\">12</span><span class=\"ds-spent\">128.00</span></button></div>",
      "css": ".ds-calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px;width:100%}.ds-day{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;aspect-ratio:1;min-width:0;padding:0;border:1px solid var(--primary,#235ee8);border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;background:white;color:var(--ink,#17212f);position:relative;overflow:hidden}.ds-day:after{content:\"\";position:absolute;top:4px;right:4px;width:3px;height:3px;border-radius:50%;background:var(--primary,#235ee8)}.ds-number{font-size:13px;font-weight:600;line-height:1.1}.ds-spent{width:100%;font-size:12px;line-height:1.2;color:#34568d;white-space:nowrap;text-align:center}.ds-day:hover{background:#cddfff}.ds-control{transition:background-color 160ms,color 160ms,transform 160ms cubic-bezier(.16,1,.3,1),box-shadow 160ms;cursor:pointer;touch-action:manipulation}.ds-control:active{transform:scale(.96)}.ds-control:disabled{opacity:.4;cursor:default;transform:none}.ds-control:focus-visible{outline:3px solid #719af2;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-control{transition-duration:1ms!important}}"
    },
    {
      "name": "四象限单区",
      "kind": "custom",
      "description": "重要且紧急区，九个方格；保留实际虚线空格、白色实心字标。",
      "html": "<section class=\"ds-quadrant\"><h3>重要且紧急<small>1/9</small></h3><div class=\"ds-qgrid\"><button class=\"ds-control ds-qcell ds-filled\" aria-label=\"重要且紧急 第一格 买药\"><strong>药</strong></button><button class=\"ds-control ds-qcell\" aria-label=\"重要且紧急 第2格 空格 添加事项\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg></button><button class=\"ds-control ds-qcell\" aria-label=\"重要且紧急 第3格 空格 添加事项\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg></button><button class=\"ds-control ds-qcell\" aria-label=\"重要且紧急 第4格 空格 添加事项\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg></button><button class=\"ds-control ds-qcell\" aria-label=\"重要且紧急 第5格 空格 添加事项\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg></button><button class=\"ds-control ds-qcell\" aria-label=\"重要且紧急 第6格 空格 添加事项\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg></button><button class=\"ds-control ds-qcell\" aria-label=\"重要且紧急 第7格 空格 添加事项\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg></button><button class=\"ds-control ds-qcell\" aria-label=\"重要且紧急 第8格 空格 添加事项\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg></button><button class=\"ds-control ds-qcell\" aria-label=\"重要且紧急 第9格 空格 添加事项\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg></button></div></section>",
      "css": ".ds-quadrant{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;padding:11px 10px;border-radius:15px;background:#fff2f1;border:1px solid #f2dedd;color:#a13f43}.ds-quadrant h3{margin:0 0 9px;display:flex;align-items:center;justify-content:space-between;gap:4px;font-size:12px}.ds-quadrant h3 small{font-size:10px;font-weight:400}.ds-qgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px}.ds-qcell{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;aspect-ratio:1;min-width:0;padding:0;display:flex;align-items:center;justify-content:center;flex-direction:column;border:1px dashed #f2dedd;border-radius:7px;background:#ffffff80;color:#a13f43;touch-action:none}.ds-filled{background:white;border-style:solid;box-shadow:0 2px 3px #20355105}.ds-qcell strong{font-size:23px;line-height:1.2;font-weight:600}.ds-qcell:hover{background:var(--soft,#edf3ff)}.ds-control{transition:background-color 160ms,color 160ms,transform 160ms cubic-bezier(.16,1,.3,1),box-shadow 160ms;cursor:pointer;touch-action:manipulation}.ds-control:active{transform:scale(.96)}.ds-control:disabled{opacity:.4;cursor:default;transform:none}.ds-control:focus-visible{outline:3px solid #719af2;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-control{transition-duration:1ms!important}}"
    },
    {
      "name": "待办完成与拖动",
      "kind": "custom",
      "description": "真实48px点击区包围20px完成标记与18px拖动图标 示例显示未完成态",
      "html": "<div class=\"ds-todo\"><button class=\"ds-control ds-check\" aria-pressed=\"false\" aria-label=\"完成 买药\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg></button><button class=\"ds-control ds-todo-text\">买药</button><button class=\"ds-control ds-drag\" aria-label=\"拖动事项\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"12\" r=\"1\"/><circle cx=\"9\" cy=\"5\" r=\"1\"/><circle cx=\"9\" cy=\"19\" r=\"1\"/><circle cx=\"15\" cy=\"12\" r=\"1\"/><circle cx=\"15\" cy=\"5\" r=\"1\"/><circle cx=\"15\" cy=\"19\" r=\"1\"/></svg></button></div>",
      "css": ".ds-todo{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;display:flex;align-items:center;gap:8px;min-height:57px;padding:7px 0;border-bottom:1px solid #eef1f5}.ds-check{width:48px;height:48px;flex:0 0 48px;padding:0;border:0;background:transparent;border-radius:9px;position:relative;display:grid;place-items:center}.ds-check:before{content:\"\";position:absolute;width:20px;height:20px;border:1.5px solid #bac4d2;border-radius:50%;background:transparent;transition:background 180ms,border-color 180ms}.ds-check svg{z-index:1;color:white;opacity:0;transition:opacity 180ms}.ds-todo-text{font-family:system-ui,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;flex:1;min-width:0;padding:2px 0;border:0;background:transparent;text-align:left;white-space:pre-wrap;overflow-wrap:anywhere;font-size:14px;line-height:1.65;color:var(--ink,#17212f)}.ds-drag{display:grid;place-items:center;flex:0 0 48px;width:48px;height:48px;border:0;border-radius:6px;background:transparent;color:#7a8aa0;padding:0;touch-action:none;user-select:none}.ds-check:hover,.ds-todo-text:hover,.ds-drag:hover{background:var(--soft,#edf3ff)}.ds-control{transition:background-color 160ms,color 160ms,transform 160ms cubic-bezier(.16,1,.3,1),box-shadow 160ms;cursor:pointer;touch-action:manipulation}.ds-control:active{transform:scale(.96)}.ds-control:disabled{opacity:.4;cursor:default;transform:none}.ds-control:focus-visible{outline:3px solid #719af2;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-control{transition-duration:1ms!important}}"
    }
  ],
  "narrative": {
    "northStar": "经典卡片日常账本",
    "overview": "这是用户选择的 C 经典卡片方向在正式 Android 应用中的实现：淡灰页面承托白色功能卡片，蓝色总额建立金额重点，深色文字维持清晰层级。紧凑页头与总额把空间让给日历，四象限以淡色分区呈现任务优先级。\n\n本文件从生产代码提取，适用于 `app/src/main/assets` 的本地 WebView 和配套原生表面。前置 YAML 是颜色、字体、圆角、间距及组件的规范层；`.impeccable/design.json` 保存动效、阴影、断点、原生尺寸和可独立渲染的组件样本。别名 `--green`、`--green-dark` 实际指向主蓝色，不是第二套绿色主题。\n\n当前为本地正式 APK 1.7.0，本轮用户要求不上传。MuMu Android 15 的 APK 截图使用独立样例数据，位于 `.tools/v170-review`；它们属于验证证据。真我 GT7 Pro、支付软件现场 OCR、已固定桌面快捷图标的真实刷新尚未验证。本文件描述源码事实，不将这些能力标为通过验证。",
    "keyCharacteristics": [
      "白色功能表面、淡灰页面、蓝色金额重点",
      "系统字体、等宽数字、捆绑 Lucide 线性图标",
      "圆角卡片和方形日期、直角柱状图",
      "状态过渡保持滚动位置与任务身份",
      "保留真实本地账本接口及日期核对规则"
    ],
    "rules": [
      {
        "name": "语义色",
        "body": "绿色只标识微信，红黄灰只承担明确状态；新增普通操作沿用主蓝。",
        "section": "colors"
      },
      {
        "name": "连续位置",
        "body": "同页任务重绘必须保留原顺序、清单滚动和页面滚动；不能用整个列表平移作为页面入场效果。",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** 从生产资产与原生资源同步提取 token，保留白黑蓝经典卡片方向。",
      "**Do** 保留系统字体、数字对齐、图标文字标签、系统减少动画和文本缩放。",
      "**Do** 保留七列日期、十二列年统计、36 格四象限和任务滚动位置。",
      "**Do** 让完成与拖动控件保持 48×48px，原生扫描控件保持 48×48dp。",
      "**Do** 保留日期核对、真实本地数据接口和账单统计规则。"
    ],
    "donts": [
      "**Don't** 使用 emoji、远程图标字体或新增未授权视觉主题。",
      "**Don't** 将日历与四象限格子改为固定 48px 而破坏手机布局。",
      "**Don't** 给统计柱子添加圆角，或以整页位移动画重置清单位置。",
      "**Don't** 把正式 APK 写成模拟数据 demo，或把模拟器样例当作真机、现场 OCR、桌面刷新验证。",
      "**Don't** 将当前源码未覆盖的动效路径或未验证的设备能力写成已完成事实。"
    ]
  }
}
